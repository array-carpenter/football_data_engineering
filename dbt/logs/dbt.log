    create  table
      "football"."main"."int_rusher_names__dbt_tmp"
  
    as (
      with name_counts as (
    select
        rusher_player_id,
        rusher_player_name,
        count(*) as usage_count
    from "football"."main"."plays"
    where rusher_player_id is not null
      and rusher_player_name is not null
    group by rusher_player_id, rusher_player_name
),

ranked as (
    select
        rusher_player_id,
        rusher_player_name,
        usage_count,
        row_number() over (
            partition by rusher_player_id
            order by usage_count desc
        ) as rn
    from name_counts
)

select
    rusher_player_id,
    rusher_player_name as canonical_name
from ranked
where rn = 1
    );
  
  
